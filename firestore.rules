// CS 393 Buddy — Firestore security rules.
//
// Per-user authorization via Firebase Auth. The extension signs in via
// our verifyStudent Cloud Function (which itself verifies identity
// against Canvas using the instructor's API token), receives a custom
// token with uid == netID, and exchanges it for a Firebase Auth ID
// token via signInWithCustomToken. Every Firestore REST call sends
// that ID token as Authorization: Bearer, and these rules enforce
// request.auth.uid against the document path.
//
// What this blocks vs. the previous schema-only rules:
//   - Anonymous writes (no Firebase Auth ID token in Authorization)
//   - Cross-student impersonation (auth.uid must match the netID in
//     the doc path or studentNetID field)
//   - Garbage shapes (the existing schema validations carry over)
//
// What's still open (TODO):
//   - classes/{classId} writes are allowed for any authed user. Once
//     there's an admin UI or Cloud Function doing seeding, restrict
//     to a specific principal.
//
// How to deploy:
//   firebase deploy --only firestore:rules
// (or paste this file's contents into the Firebase Console rules
// editor and Publish.)

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- students/{netID} ----------------------------------------------
    // Each student can only read and write their own doc. Schema is
    // also validated.
    match /students/{netID} {
      allow read: if request.auth != null && request.auth.uid == netID;
      allow write: if request.auth != null
                    && request.auth.uid == netID
                    && isValidNetID(netID)
                    && isValidStudentDoc(request.resource.data);
    }

    function isValidNetID(netID) {
      return netID is string && netID.matches('^[a-z][a-z0-9]{1,15}$');
    }

    function isValidStudentDoc(data) {
      return data.keys().hasOnly([
        'name', 'note', 'leetcodeUsername', 'solvedProblems'
      ]);
    }

    // ---- activity/{eventId} --------------------------------------------
    // Append-only event log. Only the authenticated student can write
    // events tagged with their own netID, and only via create (never
    // update/delete).
    match /activity/{eventId} {
      allow read: if false;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.studentNetID
                    && isValidActivityEvent(request.resource.data);
      allow update, delete: if false;
    }

    function isValidActivityEvent(data) {
      return data.keys().hasAll(['studentNetID', 'eventType', 'source', 'timestamp'])
          && data.keys().hasOnly([
               'studentNetID', 'eventType', 'source', 'timestamp',
               'problemSlug', 'problemTitle', 'verdict'
             ])
          && data.studentNetID is string
          && data.eventType in ['open_problem', 'submit_pass', 'submit_fail']
          && data.source == 'leetcode';
    }

    // ---- classes/{classId} ---------------------------------------------
    // Class-level config. Readable by any authenticated student.
    // Writes still open for the auto-seed path; tighten later when
    // there's a Cloud Function / admin UI doing the seeding.
    match /classes/{classId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ---- classes/{classId}/weeks/{weekNum} -----------------------------
    // Per-week assignment definitions. Readable by any authed student;
    // writes still open for auto-seed (same TODO as above).
    match /classes/{classId}/weeks/{weekNum} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isValidWeekDoc(request.resource.data);
    }

    function isValidWeekDoc(data) {
      return data.keys().hasAll(['weekNum', 'startDate', 'endDate', 'problems'])
          && data.keys().hasOnly(['weekNum', 'startDate', 'endDate', 'problems'])
          && data.weekNum is number
          && data.startDate is number
          && data.endDate is number
          && data.endDate > data.startDate
          && data.problems is list;
    }

    // ---- Default: deny --------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
