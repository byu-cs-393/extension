// CS 393 Buddy — Firestore security rules.
//
// Per-user authorization via Firebase Auth. The extension signs in via
// our verifyStudent Cloud Function (which itself verifies identity
// against Canvas using the instructor's API token), receives a custom
// token with uid == netID, and exchanges it for a Firebase Auth ID
// token via signInWithCustomToken. Every Firestore REST call sends
// that ID token as Authorization: Bearer, and these rules enforce
// request.auth.uid against the document path.
//
// What this blocks vs. the previous schema-only rules:
//   - Anonymous writes (no Firebase Auth ID token in Authorization)
//   - Cross-student impersonation (auth.uid must match the netID in
//     the doc path or studentNetID field)
//   - Garbage shapes (the existing schema validations carry over)
//
// What's still open (TODO):
//   - classes/{classId} writes are allowed for any authed user. Once
//     there's an admin UI or Cloud Function doing seeding, restrict
//     to a specific principal.
//
// How to deploy:
//   firebase deploy --only firestore:rules
// (or paste this file's contents into the Firebase Console rules
// editor and Publish.)

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- students/{netID} ----------------------------------------------
    // Read: student themselves OR anyone with role: "ta" (needed for
    // the TA dashboard's struggling-student + student-detail views).
    // Write: student themselves only. TAs don't currently need to
    // mutate student docs directly — signoff writes live one level
    // deeper on weekProgress.
    match /students/{netID} {
      allow read: if request.auth != null
                    && (request.auth.uid == netID
                        || request.auth.token.role == 'ta');
      allow write: if request.auth != null
                    && request.auth.uid == netID
                    && isValidNetID(netID)
                    && isValidStudentDoc(request.resource.data);
    }

    function isValidNetID(netID) {
      return netID is string && netID.matches('^[a-z][a-z0-9]{1,15}$');
    }

    function isValidStudentDoc(data) {
      return data.keys().hasOnly([
        'name', 'note', 'leetcodeUsername', 'solvedProblems', 'canvasUserId'
      ]);
    }

    // ---- activity/{eventId} --------------------------------------------
    // Append-only event log. Students can only create events tagged
    // with their own netID. TAs can read for the student-detail
    // timeline view.
    match /activity/{eventId} {
      allow read: if request.auth != null && request.auth.token.role == 'ta';
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.studentNetID
                    && isValidActivityEvent(request.resource.data);
      allow update, delete: if false;
    }

    function isValidActivityEvent(data) {
      return data.keys().hasAll(['studentNetID', 'eventType', 'source', 'timestamp'])
          && data.keys().hasOnly([
               'studentNetID', 'eventType', 'source', 'timestamp',
               'problemSlug', 'problemTitle', 'verdict'
             ])
          && data.studentNetID is string
          && data.eventType in ['open_problem', 'submit_pass', 'submit_fail']
          && data.source == 'leetcode';
    }

    // ---- classes/{classId} ---------------------------------------------
    // Class-level config. Readable by any authenticated student.
    // Writes still open for the auto-seed path; tighten later when
    // there's a Cloud Function / admin UI doing the seeding.
    match /classes/{classId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ---- classes/{classId}/weeks/{weekNum} -----------------------------
    // Per-week assignment definitions. Readable by any authed student;
    // writes still open for auto-seed (same TODO as above).
    //
    // `thirdCard` is an optional discriminated map describing the
    // week's third assignment slot. Exactly one of:
    //   { type: 'topicExam', topic, durationMin, examType? }
    //   { type: 'onlineAssessment', topic, attempts }
    //   { type: 'mockInterview', durationMin }
    // The rules validate `type` against the known set but trust the
    // client for deeper per-type shape (Firestore rules can't ergonomically
    // express a discriminated union).
    match /classes/{classId}/weeks/{weekNum} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                             && isValidWeekDoc(request.resource.data);
      allow delete: if request.auth != null;
    }

    function isValidWeekDoc(data) {
      return data.keys().hasAll(['weekNum', 'startDate', 'endDate', 'problems'])
          && data.keys().hasOnly(['weekNum', 'startDate', 'endDate', 'problems', 'thirdCard', 'canvasAssignmentId'])
          && data.weekNum is number
          && data.startDate is number
          && data.endDate is number
          && data.endDate > data.startDate
          && data.problems is list
          && (!('thirdCard' in data) || data.thirdCard == null || isValidThirdCard(data.thirdCard));
    }

    function isValidThirdCard(card) {
      return card is map
          && 'type' in card
          && card.type in ['topicExam', 'onlineAssessment', 'mockInterview'];
    }

    // ---- students/{netID}/weekProgress/{weekNum} -----------------------
    // Per-student progress on the week's third card. One doc per
    // (student, week) pair. Shape mirrors the catalog's `thirdCard.type`:
    //   topicExam        → { type, status, requestedAt?, ... }
    //   onlineAssessment → { type, currentAttempt, attempts[], finalStatus }
    //   mockInterview    → { type, status, partnerNetID?, ... }
    // Only the owning student can read or write their own progress.
    //
    // Delete is split out because request.resource.data is null on
    // delete — running it through the schema validator would always
    // fail. Useful for reset/test flows during development.
    match /students/{netID}/weekProgress/{weekNum} {
      // Read: owner OR TA (needed for the signoff queue).
      allow read: if request.auth != null
                    && (request.auth.uid == netID
                        || request.auth.token.role == 'ta');
      // Create/update: owner OR TA (TAs use writes here to record
      // signoff outcomes — passed/failed status on topic exams).
      allow create, update: if request.auth != null
                             && (request.auth.uid == netID
                                 || request.auth.token.role == 'ta')
                             && isValidWeekProgress(request.resource.data, weekNum);
      allow delete: if request.auth != null && request.auth.uid == netID;
    }

    function isValidWeekProgress(data, weekNum) {
      return 'type' in data
          && data.type in ['topicExam', 'onlineAssessment', 'mockInterview']
          && 'weekNum' in data
          && data.weekNum is number
          && string(int(data.weekNum)) == weekNum;
    }

    // ---- gradeSyncLog/{runId} ------------------------------------------
    // Write-only from the Cloud Function via Admin SDK (rules bypassed);
    // read access from the instructor allowlist. Keep the allowlist in
    // sync with INSTRUCTOR_ALLOWLIST in functions/index.js.
    match /gradeSyncLog/{runId} {
      allow read: if request.auth != null && request.auth.uid == 'jack684';
      allow write: if false;
    }

    // ---- Default: deny --------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
