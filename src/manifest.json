{
  "manifest_version": 3,
  "name": "CS 393 Buddy",
  "version": "1.0.8",
  "key": "",
  "description": "Track your CS 393 weekly LeetCode work, pass off topic exams with a TA, and stay synced with Canvas.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CS 393 Buddy",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "platform/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://firestore.googleapis.com/*",
    "https://leetcode.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://cs393-496021.web.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": [
        "generated/leetcode-auth.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "generated/leetcode-tracker.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "generated/keystroke-tracker.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://byu.instructure.com/*"
      ],
      "js": [
        "generated/canvas-submitter.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "generated/keystroke-injector.js"
      ],
      "matches": [
        "https://leetcode.com/*"
      ]
    }
  ]
}
