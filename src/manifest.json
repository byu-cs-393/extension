{
  "manifest_version": 3,
  "name": "CS 393 Buddy",
  "version": "0.0.1",
  "description": "Track your CS 393 weekly LeetCode work, pass off topic exams with a TA, and stay synced with Canvas.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "CS 393 Buddy"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://firestore.googleapis.com/*",
    "https://leetcode.com/*",
    "https://byu.instructure.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://cs393-496021.web.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["leetcode-auth.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["leetcode-tracker.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["keystroke-tracker.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://byu.instructure.com/*"],
      "js": ["canvas-auth.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["keystroke-injector.js"],
      "matches": ["https://leetcode.com/*"]
    }
  ]
}
